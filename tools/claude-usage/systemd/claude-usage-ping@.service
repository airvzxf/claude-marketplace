[Unit]
Description=5-hour window event of %i (close or ping)
After=network-online.target
# Retry on failure (e.g. no network at boot), at most 4 times an hour.
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude-usage --keepalive --account %i
TimeoutStartSec=10min
Restart=on-failure
RestartSec=3min
