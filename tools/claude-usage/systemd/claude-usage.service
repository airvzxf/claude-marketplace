[Unit]
Description=Mantener activas las ventanas de 5 h (todas las cuentas)
After=network-online.target
# Reintenta si falla (p. ej. sin red al arrancar), máx. 4 veces por hora.
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude-usage --keepalive
TimeoutStartSec=20min
Restart=on-failure
RestartSec=3min
